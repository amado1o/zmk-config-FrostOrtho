#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// AML クリックしたときにタイムアウトを延長

&mkp_input_listener { input-processors = <&zip_temp_layer 6 10000>; };

/ {
    combos {
        compatible = "zmk,combos";

        mkp-left-click {
            bindings = <&mkp LCLK>;
            key-positions = <16 17>;
        };

        mkp-right-click {
            bindings = <&mkp RCLK>;
            key-positions = <17 18>;
        };

        mkp-middle-click {
            bindings = <&mkp MCLK>;
            key-positions = <16 18>;
        };

        kp-enter {
            bindings = <&kp KP_ENTER>;
            key-positions = <23 26>;
        };

        wrap-paren {
            bindings = <&wrap_paren>;
            key-positions = <14 15>;
        };

        wrap-brace {
            bindings = <&wrap_brace>;
            key-positions = <24 25>;
        };

        wrap-bracket {
            bindings = <&wrap_bracket>;
            key-positions = <4 5>;
        };

        wrap-quote {
            bindings = <&wrap_quote>;
            key-positions = <10 19>;
        };

        wrap-dquote {
            bindings = <&wrap_dquote>;
            key-positions = <20 29>;
        };

        wrap-grave {
            bindings = <&wrap_grave>;
            key-positions = <0 9>;
        };
    };

    macros {
        wrap_paren: wrap_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(NUMBER_8) &kp LS(NUMBER_9) &kp LEFT_ARROW>;
            label = "WRAP_PAREN";
        };

        wrap_brace: wrap_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(RIGHT_BRACKET) &kp LS(NON_US_BSLH) &kp LEFT_ARROW>;
            label = "WRAP_BRACE";
        };

        wrap_bracket: wrap_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET &kp NON_US_BACKSLASH &kp LEFT_ARROW>;
            label = "WRAP_BRACKET";
        };

        wrap_quote: wrap_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(NUMBER_7) &kp LS(NUMBER_7) &kp LEFT_ARROW>;
            label = "WRAP_QUOTE";
        };

        wrap_dquote: wrap_dquote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(NUMBER_2) &kp LS(NUMBER_2) &kp LEFT>;
            label = "WRAP_DQUOTE";
        };

        wrap_grave: wrap_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(NON_US_HASH) &kp LS(NON_US_HASH) &kp LEFT>;
            label = "WRAP_GRAVE";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        // Kyemap Editor用

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        vol_up_down: vol_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };

        // DYA Studio用

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp SEMI  &kp COMMA     &kp DOT       &kp P                        &kp Q                                         &kp Y            &kp G           &kp D  &kp M      &kp F
&kp A     &kp O         &kp E         &lt 3 I                      &kp U                                         &kp B            &kp N           &kp T  &kp R      &kp S
&kp Z     &kp X         &kp C         &kp V                        &kp W                                         &kp H            &kp J           &kp K  &kp L      &kp MINUS
&none     &kp LEFT_WIN  &kp LEFT_ALT  &mt LEFT_CONTROL LANG_HANJA  &mt LEFT_SHIFT SPACE  &mt LEFT_ALT LANG1      &lt 2 BACKSPACE  &lt 0 KP_ENTER  &none  &lt 4 F10  &mt RIGHT_SHIFT INTERNATIONAL_1
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_1 {
            bindings = <
&kp LS(N1)  &kp LEFT_BRACKET  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)              &kp EQUAL  &kp LS(NUMBER_6)  &kp LS(APOSTROPHE)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)
&kp N1      &kp N2            &kp N3      &kp N4      &kp N5                  &kp N6     &kp N7            &kp N8              &kp N9            &kp N0
&kp F1      &kp F2            &kp F3      &kp F4      &kp F5                  &kp F6     &kp F7            &kp F8              &kp F9            &kp F10
&kp F11     &kp F12           &trans      &trans      &trans      &trans      &trans     &kp DEL           &trans              &trans            &kp ESCAPE
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_2 {
            bindings = <
&kp SLASH                   &kp N7     &kp N8  &kp N9  &kp LS(SQT)                    &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)      &kp LS(NUMBER_6)   &kp LEFT_BRACKET
&kp MINUS                   &kp N4     &kp N5  &kp N6  &kp LS(SEMICOLON)              &kp LS(N2)        &kp LS(N7)        &kp LS(LEFT_BRACKET)  &kp LS(NUMBER_8)   &kp LS(NUMBER_9)
&mt LEFT_SHIFT N0           &kp N1     &kp N2  &kp N3  &kp PERIOD                     &kp SEMICOLON     &kp SQT           &kp LS(INT_YEN)       &kp RIGHT_BRACKET  &kp BACKSLASH
&mt LEFT_CONTROL LS(MINUS)  &kp ENTER  &trans  &trans  &trans             &trans      &trans            &trans            &trans                &kp LS(NUMBER_1)   &kp EQUAL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            bindings = <
&kp APOSTROPHE  &kp LS(NUMBER_1)  &kp LS(SLASH)   &none  &none               &kp PAGE_UP    &kp BACKSPACE  &kp ESCAPE  &kp DELETE  &kp LS(NON_US_BSLH)
&kp LEFT_ALT    &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &none               &kp LEFT       &kp DOWN       &kp UP      &kp RIGHT   &kp TILDE2
&none           &kp NON_US_BSLH   &kp SLASH       &none  &none               &kp PAGE_DOWN  &kp HOME       &kp F2      &kp END     &kp LS(INTERNATIONAL_3)
&none           &none             &none           &none  &kp TAB  &none      &kp DELETE     &kp ESCAPE     &none       &none       &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans              &trans          &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans              &studio_unlock  &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans              &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_7 {
            bindings = <
&kp LC(Z)  &kp LC(Y)    &trans       &trans       &trans              &trans  &trans  &trans  &trans  &trans
&trans     &trans       &trans       &trans       &trans              &trans  &trans  &trans  &trans  &trans
&trans     &screenshot  &kp LC(INS)  &kp LS(INS)  &trans              &trans  &trans  &trans  &trans  &trans
&trans     &trans       &trans       &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
